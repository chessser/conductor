{
  "name": "conductor",
  "version": "0.1.0",
  "description": "Local MCP server giving Claude Code on-demand access to your team's knowledge (principles, ways of working, repos, infra) and guarded read/write access to Jira.",
  "type": "module",
  "license": "MIT",
  "private": true,
  "bin": {
    "conductor": "./dist/cli.js"
  },
  "engines": {
    "node": ">=22.6.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/cli.ts",
    "test": "node --test --experimental-strip-types --test-reporter=spec 'src/**/*.test.ts'",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "audit": "npm audit --audit-level=high"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "commander": "^15.0.0",
    "js-yaml": "^5.2.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20.14.0",
    "@typescript-eslint/eslint-plugin": "^7.16.0",
    "@typescript-eslint/parser": "^7.16.0",
    "eslint": "^8.57.0",
    "tsx": "^4.16.2",
    "typescript": "^5.5.3"
  }
}
