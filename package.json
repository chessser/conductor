{
  "name": "conductor",
  "version": "0.1.0",
  "description": "Local MCP server giving Claude Code on-demand access to your team's knowledge (principles, ways of working, repos, infra) and guarded read/write access to Jira.",
  "type": "module",
  "license": "MIT",
  "private": true,
  "bin": {
    "conductor": "./dist/cli.js"
  },
  "exports": {
    ".": "./dist/cli.js",
    "./schema": "./dist/conductor-schema.json",
    "./types": "./dist/types/index.d.ts"
  },
  "engines": {
    "node": ">=22.6.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && npm run build:schema",
    "build:schema": "tsx src/lib/schema-generator.ts",
    "dev": "tsx src/cli.ts",
    "test": "node --test --experimental-strip-types --test-reporter=spec 'src/**/*.test.ts'",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "audit": "npm audit --audit-level=high"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "commander": "^12.1.0",
    "js-yaml": "^4.1.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20.14.0",
    "@typescript-eslint/eslint-plugin": "^7.16.0",
    "@typescript-eslint/parser": "^7.16.0",
    "eslint": "^8.57.0",
    "tsx": "^4.16.2",
    "typescript": "^5.5.3"
  }
}
