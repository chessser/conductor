# Copy to .env (gitignored) for local `conductor sync` runs against a real Jira
# site. Auto-loaded by every `conductor` command (src/lib/env.ts) — never
# overwrites a variable already set by your shell or CI. See
# docs/how-it-works.md for the full credentials model, and docs/testing.md
# for how to get a free API token. Never commit real values, and never wire
# these into CI.

JIRA_EMAIL=you@example.com
JIRA_API_TOKEN=
